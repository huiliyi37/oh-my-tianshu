{
  "name": "@huiliyi37/dsh-command-files",
  "description": "Load user-defined slash commands from two layers of Markdown command files (user home + project .dsh), rendered through a template and steered to the model",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/interaction/command-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-commands": "^0.4.0",
    "@huiliyi37/dsh-llm": "^0.4.0",
    "@huiliyi37/dsh-paths": "^0.4.0",
    "@huiliyi37/dsh-invariants": "^0.2.0"
  },
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-commands": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-paths": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^"
  }
}
