{
  "name": "@huiliyi37/dsh-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflows",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-build.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/dsh-workflow": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/dsh-workflow": "workspace:^",
    "@huiliyi37/dsh-workflow-workerthread": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
