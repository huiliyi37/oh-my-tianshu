{
  "name": "@deepseek-ai/dsh-meridian",
  "description": "MeridianDB codebase index — SQLite symbol/edge graph + tree-sitter parsing (ts/py/go), lazy incremental indexing with backfill (Tianshu meridian port)",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "^0.0.1",
    "@deepseek-ai/dsh-pheromone": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-pheromone": "workspace:^",
    "cordis": "^4.0.0-rc.7"
  }
}
