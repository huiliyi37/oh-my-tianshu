{
  "name": "@huiliyi37/dsh-tool-memory-recall",
  "description": "memory_deep_recall: raw session-history recall through a read-only in-process reader subagent returning a fixed distilled shape (phase 3 mode C)",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/memory/tool-memory-recall"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-session-query": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/dsh-session-query": {
      "optional": true
    },
    "@huiliyi37/dsh-subagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-session-query": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/schemastery": "^3.0.0-rc.3"
  }
}
