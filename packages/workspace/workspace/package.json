{
  "name": "@huiliyi37/dsh-workspace",
  "description": "Workspace entity registry (ctx.workspace): durable workspace records with validated session attachment over the domain data form for the Tianshu Harness",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-brand": "^0.2.0",
    "@huiliyi37/dsh-storage-domain": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-session-persistence": "^0.2.0",
    "@huiliyi37/dsh-storage": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@huiliyi37/dsh-brand": "workspace:^",
    "@huiliyi37/dsh-storage-domain": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-session-persistence": "workspace:^",
    "@huiliyi37/dsh-storage": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
