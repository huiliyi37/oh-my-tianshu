{
  "name": "@huiliyi37/dsh-host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the Tianshu Harness web GUI host",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-build.git",
    "directory": "packages/host/directory-picker-auto"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/dsh-host-directory-picker-browse": "^0.2.0",
    "@huiliyi37/dsh-host-directory-picker-native": "^0.2.0",
    "@huiliyi37/dsh-host-webserver": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-host-directory-picker": "workspace:^",
    "@huiliyi37/dsh-host-directory-picker-browse": "workspace:^",
    "@huiliyi37/dsh-host-directory-picker-native": "workspace:^",
    "@huiliyi37/dsh-host-webserver": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
