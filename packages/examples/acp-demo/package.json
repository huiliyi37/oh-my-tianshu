{
  "name": "@huiliyi37/dsh-acp-demo",
  "description": "ACP automation server app: agent spine + JSONL persistence + ACP transport, with a JSON-RPC stdio bin",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/examples/acp-demo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-acp-demo": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-include": "^1.0.4",
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/dsh-acp": "^0.2.0",
    "@huiliyi37/dsh-agent-spine-demo": "^0.2.0",
    "@huiliyi37/dsh-app-boot": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-session-checkpoint-policy": "^0.2.0",
    "@huiliyi37/dsh-session-persistence-jsonl": "^0.2.0",
    "@huiliyi37/dsh-session-query": "^0.2.0",
    "@huiliyi37/dsh-session-query-sqlite": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/dsh-workspace-context": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/schemastery": "^3.17.0"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-acp": "workspace:^",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-spine-demo": "workspace:^",
    "@huiliyi37/dsh-app-boot": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-session-checkpoint-policy": "workspace:^",
    "@huiliyi37/dsh-session-persistence-jsonl": "workspace:^",
    "@huiliyi37/dsh-session-query": "workspace:^",
    "@huiliyi37/dsh-session-query-sqlite": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/dsh-workspace-context": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/schemastery": "^3.17.0"
  }
}
