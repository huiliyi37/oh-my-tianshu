{
  "name": "@huiliyi37/dsh-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Tianshu Harness LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-authorization": "^0.2.0",
    "@huiliyi37/dsh-credentials": "^0.2.0",
    "@huiliyi37/dsh-environment": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-settings": "^0.2.0",
    "@huiliyi37/dsh-timeout": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-authorization": "workspace:^",
    "@huiliyi37/dsh-credentials": "workspace:^",
    "@huiliyi37/dsh-environment": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-llm-deepseek": "workspace:^",
    "@huiliyi37/dsh-settings": "workspace:^",
    "@huiliyi37/dsh-timeout": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
