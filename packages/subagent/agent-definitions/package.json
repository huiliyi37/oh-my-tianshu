{
  "name": "@huiliyi37/dsh-agent-definitions",
  "description": "Agent role definitions (ctx.agentDefinitions): markdown-discovered delegation roles with a runtime registration seam",
  "version": "0.2.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/subagent/agent-definitions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-fs": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-paths": "^0.2.0",
    "@huiliyi37/dsh-skill": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@huiliyi37/schemastery": "^3.18.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@huiliyi37/dsh-fs": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-paths": "workspace:^",
    "@huiliyi37/dsh-skill": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
