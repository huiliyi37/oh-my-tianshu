{
  "name": "@huiliyi37/dsh-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-agent-definitions": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-model-roles": "^0.3.0",
    "@huiliyi37/dsh-settings": "^0.2.0",
    "@huiliyi37/dsh-skill": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/dsh-tasks": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/dsh-agent-definitions": {
      "optional": true
    },
    "@huiliyi37/dsh-model-roles": {
      "optional": true
    }
  },
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-definitions": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-model-roles": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-session-persistence": "workspace:^",
    "@huiliyi37/dsh-session-persistence-jsonl": "workspace:^",
    "@huiliyi37/dsh-settings": "workspace:^",
    "@huiliyi37/dsh-skill": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-subagent-spawn": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tasks": "workspace:^",
    "@huiliyi37/dsh-tasks-local": "workspace:^",
    "@huiliyi37/dsh-tool-tasks": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
