{
  "name": "@huiliyi37/dsh-subagent-inprocess",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/subagent/subagent-inprocess"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-sandbox-policy": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/dsh-user-approval": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/dsh-sandbox-policy": {
      "optional": true
    },
    "@huiliyi37/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-loop": "workspace:^",
    "@huiliyi37/dsh-agent-loop-testkit": "workspace:^",
    "@huiliyi37/dsh-fs-sandbox": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-sandbox-policy": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tool-fs": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/dsh-user-approval": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
