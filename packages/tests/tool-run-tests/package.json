{
  "name": "@huiliyi37/dsh-tool-run-tests",
  "description": "Model-facing test-runner tools: run_tests executes the detected framework through the bash seam with machine-readable counts; related_tests lists test files near a source path by filename convention",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/tests/tool-run-tests"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-bash": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-tasks": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-loop": "workspace:^",
    "@huiliyi37/dsh-agent-loop-testkit": "workspace:^",
    "@huiliyi37/dsh-bash": "workspace:^",
    "@huiliyi37/dsh-bash-local": "workspace:^",
    "@huiliyi37/dsh-evidence-gate": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-subprocess-local": "workspace:^",
    "@huiliyi37/dsh-tasks": "workspace:^",
    "@huiliyi37/dsh-tasks-local": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^"
  }
}
