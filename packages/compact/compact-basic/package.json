{
  "name": "@huiliyi37/dsh-compact-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the Tianshu Harness",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/compact/compact-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-compact": "^0.2.0",
    "@huiliyi37/dsh-commands": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-model-roles": "^0.3.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-token-meter": "^0.2.0",
    "@huiliyi37/dsh-compact-tool-result-prune": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/dsh-compact-tool-result-prune": {
      "optional": true
    },
    "@huiliyi37/dsh-model-roles": {
      "optional": true
    }
  },
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-loop": "workspace:^",
    "@huiliyi37/dsh-agent-loop-testkit": "workspace:^",
    "@huiliyi37/dsh-compact": "workspace:^",
    "@huiliyi37/dsh-commands": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-llm-retry": "workspace:^",
    "@huiliyi37/dsh-model-roles": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-settings": "workspace:^",
    "@huiliyi37/dsh-token-meter": "workspace:^",
    "@huiliyi37/dsh-compact-tool-result-prune": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
