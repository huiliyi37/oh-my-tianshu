{
  "name": "@huiliyi37/dsh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-retention": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-spill": "^0.2.0",
    "@huiliyi37/dsh-subprocess": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/dsh-timeout": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.6"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-subprocess": "workspace:^",
    "@huiliyi37/dsh-subprocess-local": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-retention": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-spill": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-timeout": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.6"
  }
}
