{
  "name": "@huiliyi37/dsh-tool-file-info",
  "description": "file_info tool + pheromone signal sources — size/mtime/line skeleton with on-demand signal recall (Tianshu file-perception port)",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/fs/tool-file-info"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/dsh-fs": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-pheromone": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/dsh-fs": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-pheromone": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
