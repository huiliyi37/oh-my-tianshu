{
  "name": "@huiliyi37/dsh-repository-plugin",
  "description": "Trusted repository package format and Cordis runtime for DeepSeek Harness",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/self-modification/repository-plugin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-plugin-prepare": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-mcp-client": "^0.2.0",
    "@huiliyi37/dsh-paths": "^0.2.0",
    "@huiliyi37/dsh-skill-local": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/cordis-plugin-loader": {
      "optional": true
    },
    "@huiliyi37/dsh-invariants": {
      "optional": true
    },
    "@huiliyi37/dsh-mcp-client": {
      "optional": true
    },
    "@huiliyi37/dsh-paths": {
      "optional": true
    },
    "@huiliyi37/dsh-skill-local": {
      "optional": true
    },
    "cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-mcp-client": "workspace:^",
    "@huiliyi37/dsh-paths": "workspace:^",
    "@huiliyi37/dsh-skill": "workspace:^",
    "@huiliyi37/dsh-skill-local": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
