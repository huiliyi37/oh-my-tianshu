{
  "name": "@huiliyi37/dsh-client-test-runtime",
  "description": "jsdom slot test runtime: real Cordis Context + SlotsService + web-react renderer with test-owned session/workspace doubles for feature specs",
  "version": "0.8.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/client/test-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-client-runtime": "^0.2.0",
    "@huiliyi37/dsh-client-ui-slots": "^0.2.0",
    "@huiliyi37/dsh-client-web-react": "^0.2.0",
    "@huiliyi37/dsh-host-apiproxy": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-client-runtime": "workspace:^",
    "@huiliyi37/dsh-client-ui-slots": "workspace:^",
    "@huiliyi37/dsh-client-web-react": "workspace:^",
    "@huiliyi37/dsh-host-apiproxy": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ]
}
