{
  "name": "@huiliyi37/dsh-web-app",
  "description": "The dsh browser-surface bundle: the web patch layer over dsh-base plus the runtime glue plugin (frontend dist serving, web-surface prompt, bash runtime variables, URL line)",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/bundle/web-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@huiliyi37/dsh-agent-presets": "workspace:^",
    "@huiliyi37/dsh-client-connection": "workspace:^",
    "@huiliyi37/dsh-client-hmr": "workspace:^",
    "@huiliyi37/dsh-client-locale": "workspace:^",
    "@huiliyi37/dsh-client-modules": "workspace:^",
    "@huiliyi37/dsh-api-remotes": "workspace:^",
    "@huiliyi37/dsh-client-runtime": "workspace:^",
    "@huiliyi37/dsh-client-ui-command": "workspace:^",
    "@huiliyi37/dsh-client-ui-conversation": "workspace:^",
    "@huiliyi37/dsh-client-ui-deliverables": "workspace:^",
    "@huiliyi37/dsh-client-ui-goal": "workspace:^",
    "@huiliyi37/dsh-client-ui-layout": "workspace:^",
    "@huiliyi37/dsh-client-ui-model": "workspace:^",
    "@huiliyi37/dsh-client-ui-models": "workspace:^",
    "@huiliyi37/dsh-client-ui-permission": "workspace:^",
    "@huiliyi37/dsh-client-ui-plan": "workspace:^",
    "@huiliyi37/dsh-client-ui-question": "workspace:^",
    "@huiliyi37/dsh-client-ui-settings": "workspace:^",
    "@huiliyi37/dsh-client-ui-settings-general": "workspace:^",
    "@huiliyi37/dsh-client-ui-sidebar": "workspace:^",
    "@huiliyi37/dsh-client-ui-skill": "workspace:^",
    "@huiliyi37/dsh-client-ui-slash": "workspace:^",
    "@huiliyi37/dsh-client-ui-subagent": "workspace:^",
    "@huiliyi37/dsh-client-ui-theme": "workspace:^",
    "@huiliyi37/dsh-client-ui-tool": "workspace:^",
    "@huiliyi37/dsh-client-ui-trajectory": "workspace:^",
    "@huiliyi37/dsh-client-ui-workspace": "workspace:^",
    "@huiliyi37/dsh-code-runtime-worker": "workspace:^",
    "@huiliyi37/dsh-command-memory": "workspace:^",
    "@huiliyi37/dsh-environment": "workspace:^",
    "@huiliyi37/dsh-frontend": "workspace:^",
    "@huiliyi37/dsh-frontend-static": "workspace:^",
    "@huiliyi37/dsh-host-apiproxy": "workspace:^",
