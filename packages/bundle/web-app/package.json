    "@huiliyi37/dsh-host-webserver": "workspace:^",
    "@huiliyi37/dsh-memory": "workspace:^",
    "@huiliyi37/dsh-session-projection-cache": "workspace:^",
    "@huiliyi37/dsh-storage": "workspace:^",
    "@huiliyi37/dsh-storage-domain": "workspace:^",
