{
  "name": "@huiliyi37/dsh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Tianshu Harness",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-atomic-write": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-paths": "^0.2.0",
    "@huiliyi37/dsh-scope": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-settings": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-loop": "workspace:^",
    "@huiliyi37/dsh-atomic-write": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-paths": "workspace:^",
    "@huiliyi37/dsh-scope": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-settings": "workspace:^",
    "@huiliyi37/dsh-settings-local": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
