{
  "name": "@huiliyi37/dsh-vision-bridge",
  "description": "视觉桥插件：主控模型不识图时，把用户图片附件经独立视觉模型转文字描述，随 agent/pre-step 注入模型可见上下文",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/context/vision-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
