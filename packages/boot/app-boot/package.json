{
  "name": "@huiliyi37/dsh-app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/boot/app-boot"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-group": "^1.0.0",
    "@huiliyi37/cordis-plugin-hmr": "^1.0.15",
    "@huiliyi37/cordis-plugin-include": "^1.0.4",
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/dsh-environment": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-paths": "^0.2.0",
    "@huiliyi37/dsh-system-prompt": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@huiliyi37/cordis-plugin-hmr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-group": "workspace:^",
    "@huiliyi37/cordis-plugin-hmr": "workspace:^",
    "@huiliyi37/cordis-plugin-include": "workspace:^",
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/cordis-plugin-timer": "workspace:^",
    "@huiliyi37/dsh-environment": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-paths": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
