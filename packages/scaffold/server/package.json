{
  "name": "@huiliyi37/dsh-jsonrpc",
  "description": "Stdio JSON-RPC server plugin for out-of-process Tianshu Harness SDK clients",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/oh-my-tianshu.git",
    "directory": "packages/scaffold/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@huiliyi37/schemastery": "^3.17.0"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-llm-deepseek": "^0.2.0",
    "@huiliyi37/dsh-scope": "^0.2.0",
    "@huiliyi37/dsh-sdk-protocol": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/cordis-plugin-loader": "workspace:^",
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-spine-demo": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-llm-deepseek": "workspace:^",
    "@huiliyi37/dsh-scope": "workspace:^",
    "@huiliyi37/dsh-sdk-protocol": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-session-persistence-jsonl": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
