    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-brand": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-subprocess": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/dsh-brand": "workspace:^",
    "@huiliyi37/dsh-hooks-claude": "workspace:^",
    "@huiliyi37/dsh-hooks-codex": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-session-persistence-jsonl": "workspace:^",
    "@huiliyi37/dsh-session-persistence-sqlite": "workspace:^",
    "@huiliyi37/dsh-subprocess": "workspace:^",
    "@huiliyi37/dsh-tool-subagent": "workspace:^",
    "@huiliyi37/dsh-tool-todo": "workspace:^",
    "@huiliyi37/dsh-tool-web": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
