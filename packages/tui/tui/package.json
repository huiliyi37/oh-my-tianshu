{
  "name": "@huiliyi37/dsh-tui",
  "description": "The dsh terminal UI profile bundle: an interactive TUI layer over dsh-base (scaffold; the render core lands with tui-render-core)",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/tui/tui"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-agent-default-model": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-user-interaction": "^0.2.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-default-model": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/dsh-user-approval": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "@huiliyi37/dsh-user-interaction": "workspace:^"
  },
  "dependencies": {
    "@huiliyi37/dsh-permission": "workspace:^",
    "chalk": "^6.0.0",
    "diff": "^9.0.0",
    "get-east-asian-width": "^1.6.0",
    "string-width": "^8.2.2"
  }
}
