{
  "name": "@huiliyi37/cordis-plugin-include",
  "description": "Include files in cordis configurations",
  "version": "1.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-build.git",
    "directory": "vendor/include"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@huiliyi37/cordis-plugin-loader": "^1.0.0-rc.5",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@huiliyi37/cosmokit": "^1.8.1",
    "js-yaml": "^4.1.0"
  }
}
